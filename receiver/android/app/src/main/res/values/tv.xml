<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="tv_safe_horizontal">48dp</dimen>
    <dimen name="tv_safe_vertical">27dp</dimen>

    <style name="Tv" />
    <style name="Tv.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Tv.Button" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/button_text</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Tv.Button.Controls">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minHeight">84dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Tv.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/field_background</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="android:textSize">21sp</item>
    </style>
    <style name="Tv.CheckBox" parent="@android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/field_background</item>
        <item name="android:buttonTint">@color/ink</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
